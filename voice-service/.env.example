# Voice Service — Environment Variables
# Copy to .env and fill in. .env is gitignored.

# Shared secret for HS256 service-token verification.
# MUST match VOICE_SERVICE_JWT_SECRET in the Next.js .env file.
VOICE_SERVICE_JWT_SECRET=

# Cloudflare Workers AI — same values as the Next.js .env. Used as the
# fallback provider for any language Sarvam doesn't handle (or when
# Sarvam fails / SARVAM_API_KEY is unset).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sarvam AI — used for Indian language STT/TTS (hi, ta, te, bn, mr, gu,
# kn, ml, pa, od, en-IN). Get a key from https://dashboard.sarvam.ai/
# Free tier ships with developer credits. Leave blank to disable Sarvam
# entirely — the router will use Cloudflare for all languages.
SARVAM_API_KEY=sk_0oh9ylve_LYKhHOBSwtTYMhdlJZFp5sWz

# Bind config (defaults are fine for local dev).
HOST=127.0.0.1
PORT=8001
